{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "card-duel",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "cardduel.ooctav.io", "custom_domain": true, "previews_enabled": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "card-duel",
      "database_id": "6342b7bf-4ef6-424a-9c68-01663a26690a",
      "migrations_dir": "migrations"
    }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Matchmaker"] }
  ],
  "vars": { "CLERK_PUBLISHABLE_KEY": "", "APP_ORIGIN": "" },
  "observability": { "enabled": true },
  "previews": {
    "durable_objects": {
      "bindings": [
        { "name": "ROOMS", "class_name": "Room" },
        { "name": "MATCHMAKER", "class_name": "Matchmaker" }
      ]
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "card-duel-preview",
        "database_id": "6e0c42a7-5685-407d-97c7-d34054baae6e",
        "migrations_dir": "migrations"
      }
    ],
    "vars": { "CLERK_PUBLISHABLE_KEY": "", "APP_ORIGIN": "" }
  }
}
