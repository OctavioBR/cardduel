{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // One Worker serves the client, the HTTP API and (later) Room WebSockets (ADR-0001).
  // Everything here fits the Workers Free plan: no paid-only settings.
  "name": "card-duel",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
