{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // One Worker serves the client, the HTTP API and Room WebSockets (ADR-0001).
  "name": "card-duel",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Production is served only on its Custom Domain (#114): one origin keeps sessions,
  // Room links and social previews consistent. Cloudflare manages its DNS record and certificate.
  "routes": [{ "pattern": "cardduel.ooctav.io", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "card-duel",
      "database_id": "6342b7bf-4ef6-424a-9c68-01663a26690a",
      "migrations_dir": "migrations"
    }
  ],
  // The Free plan only offers SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
