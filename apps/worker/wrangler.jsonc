{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // One Worker serves the client, the HTTP API and (later) Room WebSockets (ADR-0001).
  // Everything here fits the Workers Free plan: no paid-only settings.
  "name": "card-duel",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // Accounts, Decks, Match results and Records (ADR-0005). The production database id comes
  // from the provisioning issue (#6); local development and tests use a local D1.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "card-duel",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // The Free plan only offers SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
