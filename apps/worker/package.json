{
  "name": "@card-duel/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply DB --local && wrangler dev --port 8787 --infer-origin-from-routes=false",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "wrangler types --strict-vars=false >/dev/null && tsc -p .",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.2",
    "vitest": "4.1.12",
    "wrangler": "4.162.0"
  },
  "dependencies": {
    "@card-duel/catalog": "workspace:*",
    "@card-duel/engine": "workspace:*",
    "@card-duel/strings": "workspace:*",
    "@clerk/backend": "^3.30.0"
  }
}
