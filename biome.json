{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/dist", "!**/.wrangler", "!**/worker-configuration.d.ts", "!README.md"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/engine/**"],
      "plugins": ["./tools/biome/no-math-random.grit", "./tools/biome/no-date.grit"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "The engine runs in the Worker and the browser: no DOM APIs.",
                  "document": "The engine runs in the Worker and the browser: no DOM APIs.",
                  "process": "The engine runs in the Worker and the browser: no Node APIs.",
                  "fetch": "The engine is pure: no I/O."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/**",
        "!apps/web/src/room/local-room.ts",
        "!apps/web/src/**/*.test.ts",
        "!apps/web/src/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@card-duel/engine"],
                    "importNamePattern": "[a-z].*",
                    "message": "UI renders only the view and its legal actions (ADR-0002). Only the Local Room may import engine logic; types and constants are fine."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
