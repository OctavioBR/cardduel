{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/dist", "!**/.wrangler", "!**/worker-configuration.d.ts"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/engine/**"],
      "plugins": ["./tools/biome/no-math-random.grit", "./tools/biome/no-date.grit"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "The engine runs in the Worker and the browser: no DOM APIs.",
                  "document": "The engine runs in the Worker and the browser: no DOM APIs.",
                  "process": "The engine runs in the Worker and the browser: no Node APIs.",
                  "fetch": "The engine is pure: no I/O."
                }
              }
            }
          }
        }
      }
    }
  ]
}
